FROM python:2.7-alpine

# Runtime (.so) que suelen exigir lxml, Pillow, psycopg2, etc.
RUN apk add --no-cache \
    openssh-server \
    openssh-client \
    apache2 \
    nodejs \
    npm \
    bash \
    git \
    sudo \
    libxml2 \
    libxslt \
    libjpeg-turbo \
    freetype \
    zlib \
    libpq \
    libffi \
    openssl

RUN mkdir -p /var/run/sshd
RUN ssh-keygen -A
RUN adduser -D -s /bin/bash deploy
RUN echo "deploy:deploy" | chpasswd
RUN echo "deploy ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers
RUN mkdir -p /var/www
RUN mkdir -p /home/deploy/.ssh
RUN chown -R deploy:deploy /var/www
COPY ./keys/b/deploy/ /home/deploy/.ssh
RUN chmod 600 /home/deploy/.ssh/id_rsa
WORKDIR /var/www
COPY ultrabox_legacy/requirements.txt .
# Compilar extensiones C (lxml, Pillow, psycopg2, pycrypto, etc.): build + *-dev
# python:2.7-alpine ya trae headers en /usr/local; no uses python-dev del apk (otro Python).
RUN apk add --no-cache --virtual .build-deps \
    build-base \
    linux-headers \
    libffi-dev \
    openssl-dev \
    libxml2-dev \
    libxslt-dev \
    jpeg-dev \
    zlib-dev \
    freetype-dev \
    postgresql-dev \
    && pip install --no-cache-dir -r requirements.txt \
    && apk del .build-deps
# Copiar el resto del código
COPY ultrabox_legacy/ .
# Crear directorio para archivos estáticos
RUN mkdir -p /app/static

RUN ssh-keyscan bitbucket.org >> /home/deploy/.ssh/known_hosts
RUN chown -R deploy:deploy /home/deploy/.ssh/
# RUN git clone git@bitbucket.org:rodrihgod/ansible.git
EXPOSE 22 8001
CMD ["/usr/sbin/sshd", "-D"]